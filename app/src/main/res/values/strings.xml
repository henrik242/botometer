<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Botometer</string>
    <string name="channel_location">Posisjonssporing</string>
    <string name="notification_title">Botometer er aktiv</string>
    <string name="notification_text">Leser posisjon for å vise fartsgrense og bøtenivå.</string>
    <!-- Statens vegvesen krever at API-klienter identifiserer seg. Bytt til noe som
         identifiserer din installasjon. Unngå personnavn: verdien havner i Vegvesenets logger. -->
    <string name="nvdb_client_id" translatable="false">botometer-android</string>
    <string name="refresh_rates">Oppdater satser</string>
    <string name="grant_permissions">Gi tilganger</string>
    <!-- Etter to avslag kommer tillatelsesdialogen aldri mer, og «Gi tilganger» ville vært en
         knapp som ikke gjorde noe. Da er innstillingssiden den eneste veien. -->
    <string name="open_app_settings">Åpne innstillinger</string>
    <!-- Egen kanal, og med vilje IMPORTANCE_HIGH: dette er det ene varselet som skal sees.
         Posisjonsvarselet er IMPORTANCE_LOW nettopp for å ikke bli sett. -->
    <string name="channel_alerts">Fartsvarsler</string>
    <!-- Samme varsel uten heads-up på telefonen. Egen kanal fordi viktighet ikke kan endres
         etter at en kanal er opprettet. -->
    <string name="channel_alerts_quiet">Fartsvarsler (stille på telefonen)</string>
    <!-- Manuell fartsgrense: NVDB dekker ikke private veger, ny veg eller strekninger der
         fartsgrenseobjektet mangler, og der sluttet appen å regne i det hele tatt. -->
    <string name="manual_limit_auto">Auto</string>
    <!-- «Avslutt» stopper posisjonssporingen, den skjuler ikke bare skjermen. En app som leser
         GPS må kunne skrus av der den vises. -->
    <string name="exit">Avslutt</string>
    <!-- «Trykk to ganger for å avslutte», slik alle andre gjør det. Ett trykk kan ikke få lov:
         avslutt stopper posisjonssporingen, og et uhell med tommelen skal ikke slå av
         fartsvarslene midt i en kjøretur. -->
    <string name="press_back_again">Trykk en gang til for å avslutte og stoppe sporingen</string>
    <string name="clear_crash_log">Tøm krasjloggen</string>
    <!-- Hele diagnostikkrapporten til utklippstavla. Å markere fem skjermhøyder med tekst på en
         telefon er en øvelse ingen orker å gjøre riktig. -->
    <string name="copy_diagnostics">Kopier diagnostikk</string>
    <!-- Samme varsel som en ekte overtredelse, på kommando. Ellers krever hver runde med
         feilsøking av bilvarslene at noen kjører for fort med bilen tilkoblet. -->
    <string name="send_test_alert">Send testvarsel</string>
    <string name="show_diagnostics">Vis diagnostikk</string>
    <string name="hide_diagnostics">Skjul diagnostikk</string>

    <string name="settings_heading">INNSTILLINGER</string>
    <string name="setting_phone_alerts">Varsler på telefonen</string>
    <!-- «Av» kan ikke bety «ingenting postes»: bilverten leser varslene fra telefonens
         varselstrøm, så et varsel i bilen forutsetter et varsel på telefonen. -->
    <string name="setting_phone_alerts_help">Av: varselet spretter ikke opp på telefonen, det legger seg stille i varselpanelet. Varselet på bilskjermen kommer som før.</string>
    <string name="setting_car_alerts">Varsler på bilskjermen</string>
    <string name="setting_car_alerts_help">Av: fartsvarslene vises ikke på bilskjermen. Du får dem fortsatt på telefonen.</string>
    <!-- Hovedbryteren. Den het en gang «sporing i bakgrunnen» og betydde bare om bil-økta fikk
         holde på GPS-en mens Maps eide bilskjermen — altså et valg mellom to grader av på. En
         bryter som lar appen lese posisjon uansett stilling er ikke en av-bryter. -->
    <string name="setting_enabled">Botometer er på</string>
    <string name="setting_enabled_help">Av: alt stopper — posisjonssporingen, speedometeret her og i bilen, fartsvarslene og oppslagene mot Vegvesenets fartsgrensedata. Appen leser ingenting og bruker ingen data før du slår den på igjen.</string>
    <string name="always_allow_location">Posisjon: tillat alltid</string>
    <!-- Oppdateringskanal for bøtesatsene. Uten Play må satsene kunne hentes uavhengig av
         APK-versjonen, ellers kjører gamle installasjoner utdaterte tall i stillhet. -->
    <string name="satser_url" translatable="false">https://raw.githubusercontent.com/henrik242/botometer/main/satser/botesatser.json</string>
</resources>
