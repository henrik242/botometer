<!--
  Ikonet brukes tre steder: telefonens launcher, bilens app-oversikt og Action.APP_ICON /
  CarIcon.APP_ICON inne i templatene. Bilens launcher og APP_ICON tegner det lite, så motivet
  må tåle nedskalering, og masker kan beskjære det. Derfor:

  - alt motiv holdes innenfor sikkerhetssonen (r <= 33 fra midten av 108x108), ellers spiser
    den runde masken av ringen
  - fillType="evenOdd" på ringen. Uten den avhenger hullet av at delbanene har motsatt
    viklingsretning, og en redigering som snur en sweep-flag fyller ringen igjen i stillhet
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Bakgrunnen er full bleed. Bare den kan gå ut i hjørnene. -->
    <path android:fillColor="#0C0C0E" android:pathData="M0,0h108v108h-108z" />

    <!-- Speedometerring, r 23..31. -->
    <path
        android:fillColor="#E63C3C"
        android:fillType="evenOdd"
        android:pathData="M54,23a31,31 0 1,0 0.01,0z M54,31a23,23 0 1,1 -0.01,0z" />

    <!-- Viser, fra navet mot ca. klokka to. Tuppen ligger på r ~22, godt innenfor ringen. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51.9,51.9L65.9,37.9L70.1,42.1L56.1,56.1z" />

    <!-- Nav. -->
    <path android:fillColor="#FFFFFF" android:pathData="M54,48a6,6 0 1,0 0.01,0z" />
</vector>
