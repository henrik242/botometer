<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Kreves for NavigationTemplate og for å få tegne på bilskjermen. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Valgfritt: bilens rapporterte fart, kun for å vise speedometeravvik.
         Mange hovedenheter avslår denne. -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />

    <!-- Fra Android 11 er andre pakker usynlige som standard. Uten dette ser diagnostikken i
         telefon-appen verken Android Auto eller andre bil-apper, og ville rapportert «ikke
         installert» om en vert som står der. Vi ber om nøyaktig de to tingene, ikke
         QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <!-- Ingen <uses-feature> for android.hardware.type.automotive eller
         android.software.car.templates_host. De to markerer en app som Android Automotive
         OS-app, mens com.google.android.gms.car.application-metadataen over markerer den som
         Android Auto-app (projisert fra telefonen). Play avviser en artefakt som hevder begge
         deler: «The app cannot declare 'android.hardware.type.automotive' device feature and
         'com.google.android.gms.car.application' metadata at the same time.»

         Denne appen er projisert - se app-projected i build.gradle.kts. Skal den en gang
         bygges for Automotive OS, er det en egen variant med app-automotive, uten
         gms.car.application-metadataen, og da hører disse to hjemme igjen. CarAppManifestTest
         holder dem ute i mellomtiden: Play oppdager det først ved opplasting. -->

    <application
        android:name=".BotometerApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:appCategory="maps">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="3" />

        <!-- label og icon MÅ stå her, ikke bare på <application>. Verten bruker
             attributtene på selve CarAppService til å representere appen i bilens
             system-UI, og uten dem har den ingenting å tegne en launcher-oppføring
             med - appen blir stille borte fra app-oversikten i bilen.
             https://developer.android.com/training/cars/apps/library/set-up-project -->
        <service
            android:name=".car.BotometerCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- Speedometer er ikke en egen kategori i Car App Library. NAVIGATION er den
                     eneste kategorien som gir tilgang til en fri tegneflate. Se README. -->
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- Uten en foreground service av typen location slutter posisjonen å komme så snart
             telefonskjermen slukkes. Dette er alternativet til ACCESS_BACKGROUND_LOCATION. -->
        <service
            android:name=".speed.LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Speedometeret på telefonen, til bruk mens Maps eier bilskjermen. Ikke exported:
             ingen andre apper har noe her å gjøre. -->
        <activity
            android:name=".PhoneSpeedometerActivity"
            android:exported="false"
            android:label="@string/phone_speedometer_title"
            android:screenOrientation="fullSensor" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
